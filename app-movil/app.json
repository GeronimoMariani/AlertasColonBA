{
  "expo": {
    "name": "Alertas Colón",
    "slug": "alertas-colon-ba",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0d0c0c",
    "ios": {
      "bundleIdentifier": "com.alertascolon.ba.movil",
      "supportsTablet": false
    },
    "android": {
      "package": "com.alertascolon.ba.movil",
      "versionCode": 6,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#0d0c0c"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      "@react-native-vector-icons/lucide",
      [
        "expo-notifications",
        {
          "color": "#d8261e",
          "sounds": [
            "./assets/sounds/sirena.mp3"
          ],
          "defaultChannel": "alertas_v1"
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://alertasbomberoscolonba.com.ar",
      "eas": {
        "projectId": "53078930-1538-4d49-ac9f-5ca39b2f49cc"
      }
    }
  }
}
